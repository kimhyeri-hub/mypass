# 이 파일을 복사해서 .env로 만들고 실제 값을 채우세요.
# cp .env.example .env

# --- EC2 배포 서버 (기본값) ---
# 탄력적 IP를 설정하지 않아서 EC2 인스턴스를 껐다 켤 때마다 퍼블릭 IP가 바뀔 수 있습니다.
# AWS 콘솔 > EC2 > 인스턴스 상세에서 "퍼블릭 IPv4 주소"를 확인해서 매번 이 줄을 갱신하세요.
VITE_API_BASE_URL=http://<EC2_퍼블릭_IP>:8080

# --- 로컬 개발용 ---
# 내 PC에서 백엔드(Spring Boot)를 직접 띄워서 테스트할 때는 위 줄을 주석 처리하고 이 줄의 주석을 푸세요.
# VITE_API_BASE_URL=http://localhost:8080

# --- 면접관 음성(TTS) ---
# 비우면 브라우저 음성을 사용합니다. 남성/여성 버튼은 이때도 표시됩니다.
# 브라우저에 선택한 성별의 한국어 음성(InJoon, SunHi, Heami)이 없으면
# 다른 한국어 음성으로 재생하며, 화면에서 성별이 다를 수 있다고 안내합니다.
#
# 서버 TTS를 쓰려면 백엔드 주소만 넣으세요. 비밀키는 넣지 않습니다.
# 아래 세 형태는 모두 같은 요청 POST {서버}/api/tts 로 맞춰집니다.
#   http://localhost:8080
#   http://localhost:8080/api
#   http://localhost:8080/api/tts
# VITE_TTS_URL=http://localhost:8080
