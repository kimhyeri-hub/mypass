const navEl = document.getElementById('nav');
const screenEl = document.getElementById('screen');
const urlEl = document.getElementById('url');
const capUser = document.getElementById('cap-user');
const capSystem = document.getElementById('cap-system');

function renderNav(activeKey){
  navEl.innerHTML = screens.map(s => `
    <button class="nav-item ${s.key===activeKey?'active':''}" data-key="${s.key}">
      <span class="nav-num">${s.num}</span>
      <span class="nav-label">${s.label}</span>
    </button>
  `).join('');
  navEl.querySelectorAll('.nav-item').forEach(btn=>{
    btn.addEventListener('click', ()=> setScreen(btn.dataset.key));
  });
}

function setScreen(key){
  const s = screens.find(s=>s.key===key);
  screenEl.classList.remove('browser-body');
  void screenEl.offsetWidth;
  screenEl.classList.add('browser-body');
  screenEl.innerHTML = s.render();
  urlEl.textContent = s.url;
  capUser.textContent = s.userAction;
  capSystem.textContent = s.systemAction;
  renderNav(key);
}

