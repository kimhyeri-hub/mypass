<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MYPASS — AI 음성 모의면접 웹사이트</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.css">
<style>
  :root{
    --bg:#F5F4FC;
    --surface:#FFFFFF;
    --surface-2:#EFEDFA;
    --ink:#15162E;
    --ink-soft:#6A6A85;
    --ink-faint:#9A9AB2;
    --line:#E4E2F1;
    --brand:#3B2FE0;
    --brand-dark:#2A20AD;
    --brand-soft:#EAE8FD;
    --accent:#FF6A3D;
    --accent-soft:#FFE9DF;
    --success:#189A5C;
    --success-soft:#E3F6EC;
    --radius-lg:20px;
    --radius-md:14px;
    --radius-sm:9px;
    --font:'Pretendard Variable','Pretendard',-apple-system,'Apple SD Gothic Neo','Malgun Gothic',sans-serif;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);font-family:var(--font);color:var(--ink);-webkit-font-smoothing:antialiased;}
  ::selection{background:var(--brand-soft);}

  /* Topbar */
  .topbar{display:flex;align-items:center;justify-content:space-between;padding:22px clamp(20px,5vw,64px) 0;max-width:1240px;margin:0 auto;}
  .logo{font-size:22px;font-weight:800;letter-spacing:-0.02em;}
  .logo span{color:var(--brand);}
  .badge-tag{font-size:12.5px;font-weight:600;color:var(--brand-dark);background:var(--brand-soft);border-radius:100px;padding:7px 14px;}

  .hero{max-width:1240px;margin:0 auto;padding:34px clamp(20px,5vw,64px) 8px;}
  .hero h1{font-size:clamp(26px,3.2vw,36px);line-height:1.32;font-weight:800;letter-spacing:-0.02em;margin:0 0 12px;max-width:640px;}
  .hero p{font-size:15px;color:var(--ink-soft);margin:0;max-width:540px;line-height:1.6;}

  .stage{max-width:1240px;margin:0 auto;padding:32px clamp(20px,5vw,64px) 80px;display:grid;grid-template-columns:230px 1fr;gap:26px;align-items:start;}

  /* Left step nav */
  .nav{display:flex;flex-direction:column;gap:4px;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);padding:10px;position:sticky;top:24px;}
  .nav-item{display:flex;align-items:center;gap:11px;padding:12px;border-radius:var(--radius-md);cursor:pointer;background:transparent;border:none;text-align:left;font-family:var(--font);transition:background .15s ease;width:100%;}
  .nav-item:hover{background:var(--surface-2);}
  .nav-item.active{background:var(--brand);}
  .nav-num{font-size:12px;font-weight:700;font-variant-numeric:tabular-nums;color:var(--ink-faint);width:22px;flex:none;}
  .nav-item.active .nav-num{color:#C9C4FF;}
  .nav-label{font-size:14.5px;font-weight:600;}
  .nav-item.active .nav-label{color:#fff;}

  /* Browser mockup */
  .browser-wrap{display:flex;flex-direction:column;gap:20px;}
  .browser-frame{width:100%;background:#fff;border-radius:16px;overflow:hidden;border:1px solid var(--line);box-shadow:0 30px 60px -30px rgba(30,20,90,.28);}
  .browser-bar{height:42px;background:#F1EFFA;display:flex;align-items:center;gap:12px;padding:0 16px;border-bottom:1px solid var(--line);}
  .browser-dots{display:flex;gap:6px;flex:none;}
  .browser-dots span{width:9px;height:9px;border-radius:50%;background:#D9D6EE;display:block;}
  .browser-url{flex:1;background:#fff;border-radius:100px;padding:6px 14px;font-size:11.5px;color:var(--ink-faint);border:1px solid var(--line);}
  .browser-body{min-height:600px;display:flex;flex-direction:column;animation:fadein .28s ease;}
  @keyframes fadein{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}

  /* App top nav inside the site */
  .appnav{display:flex;align-items:center;justify-content:space-between;padding:16px 32px;border-bottom:1px solid var(--line);flex:none;}
  .appnav-brand{font-weight:800;font-size:15px;}
  .appnav-brand span{color:var(--brand);}
  .appnav-menu{display:flex;gap:26px;}
  .appnav-menu a{font-size:13px;font-weight:600;color:var(--ink-soft);}
  .appnav-menu a.active{color:var(--brand);}
  .appnav-right{display:flex;align-items:center;gap:14px;}
  .avatar{width:32px;height:32px;border-radius:10px;background:var(--brand-soft);display:flex;align-items:center;justify-content:center;font-size:14px;flex:none;}
  .exit-link{font-size:12.5px;color:var(--ink-faint);font-weight:600;}

  .page{padding:32px 40px;flex:1;}

  /* Shared atoms */
  .scr-title{font-size:21px;font-weight:800;letter-spacing:-0.01em;margin:0 0 4px;}
  .scr-sub{font-size:13px;color:var(--ink-soft);margin:0 0 22px;}
  .field{margin-bottom:14px;}
  .field label{display:block;font-size:12px;font-weight:600;color:var(--ink-soft);margin-bottom:6px;}
  .field input{width:100%;padding:12px 13px;border-radius:var(--radius-sm);border:1px solid var(--line);font-family:var(--font);font-size:13.5px;background:#FBFAFF;}
  .btn{border:none;font-family:var(--font);font-weight:700;font-size:14px;border-radius:var(--radius-sm);padding:12px 20px;cursor:pointer;}
  .btn-block{width:100%;}
  .btn-primary{background:var(--brand);color:#fff;}
  .btn-accent{background:var(--accent);color:#fff;}
  .btn-ghost{background:var(--surface-2);color:var(--ink);}
  .btn-line{background:#fff;border:1px solid var(--line);color:var(--ink-soft);}
  .link-row{text-align:center;font-size:12.5px;color:var(--ink-faint);margin-top:16px;}
  .link-row b{color:var(--brand);font-weight:700;}
  .row-between{display:flex;justify-content:space-between;align-items:center;}

  .card{background:#FBFAFF;border:1px solid var(--line);border-radius:var(--radius-md);padding:16px 17px;}
  .card-title{font-size:13.5px;font-weight:700;margin:0 0 3px;}
  .card-sub{font-size:11.5px;color:var(--ink-soft);margin:0;}
  .chip{display:inline-flex;font-size:10.5px;font-weight:700;color:var(--brand-dark);background:var(--brand-soft);border-radius:100px;padding:4px 9px;margin:6px 4px 0 0;}

  /* Login split */
  .auth-wrap{display:grid;grid-template-columns:1fr 1.1fr;min-height:600px;}
  .auth-brand{background:linear-gradient(155deg,var(--brand),#241a9e);color:#fff;padding:44px;display:flex;flex-direction:column;justify-content:space-between;}
  .auth-brand .tag{font-size:24px;font-weight:800;line-height:1.42;letter-spacing:-0.01em;}
  .auth-brand .sub{font-size:12.5px;opacity:.75;line-height:1.6;max-width:230px;}
  .auth-form{padding:56px 64px;display:flex;flex-direction:column;justify-content:center;max-width:400px;}
  .checkrow{display:flex;justify-content:space-between;align-items:center;font-size:12px;color:var(--ink-faint);margin-bottom:20px;}

  /* Dashboard */
  .dash-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;}
  .dash-grid{display:grid;grid-template-columns:2fr 1fr;gap:20px;}
  .section-title{font-size:13px;font-weight:700;color:var(--ink-soft);margin:0 0 12px;}
  .proj-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  .cta-card{background:linear-gradient(155deg,var(--accent),#e0501f);color:#fff;border-radius:var(--radius-md);padding:20px;margin-bottom:14px;}
  .cta-card .t1{font-weight:800;font-size:14.5px;margin-bottom:4px;}
  .cta-card .t2{font-size:11.5px;opacity:.85;margin-bottom:14px;}
  .cta-card button{background:#fff;color:var(--accent);}

  /* Form grid */
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 18px;max-width:640px;}
  .form-grid .full{grid-column:1 / -1;}

  /* Upload */
  .upload-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:24px;}
  .dropzone{border:1.5px dashed #C9C4EF;border-radius:var(--radius-md);background:#FBFAFF;padding:44px 20px;text-align:center;}
  .dropzone .ic{font-size:30px;margin-bottom:10px;}
  .dropzone .t1{font-size:13.5px;font-weight:700;margin-bottom:4px;}
  .dropzone .t2{font-size:11.5px;color:var(--ink-faint);}
  .steplist{display:flex;flex-direction:column;gap:10px;}
  .step-row{display:flex;align-items:center;gap:10px;font-size:12.5px;color:var(--ink-soft);}
  .step-dot{width:20px;height:20px;border-radius:50%;background:var(--success-soft);color:var(--success);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;flex:none;}
  .step-dot.pending{background:var(--surface-2);color:var(--ink-faint);}
  .progress{height:7px;border-radius:100px;background:var(--surface-2);overflow:hidden;margin:16px 0;}
  .progress > div{height:100%;background:var(--brand);border-radius:100px;}

  /* Setup */
  .setup-card{max-width:520px;}
  .seg{display:flex;gap:8px;margin-bottom:20px;}
  .seg button{flex:1;padding:10px 4px;border-radius:var(--radius-sm);border:1px solid var(--line);background:#fff;font-family:var(--font);font-size:12.5px;font-weight:600;color:var(--ink-soft);}
  .seg button.active{background:var(--brand);border-color:var(--brand);color:#fff;}

  /* Interview */
  .iv-grid{display:grid;grid-template-columns:1fr 190px;gap:28px;}
  .qpill{display:inline-block;font-size:11px;font-weight:700;color:var(--ink-faint);margin-bottom:12px;}
  .qbubble{background:var(--brand-soft);border-radius:16px 16px 16px 4px;padding:18px 20px;font-size:15px;line-height:1.6;margin-bottom:12px;max-width:480px;}
  .tts-row{display:flex;align-items:center;gap:8px;font-size:11.5px;color:var(--brand-dark);font-weight:700;margin-bottom:28px;}
  .wave{display:flex;align-items:flex-end;gap:2px;height:14px;}
  .wave i{width:2.5px;background:var(--brand);border-radius:2px;animation:wv 1s ease-in-out infinite;}
  .wave i:nth-child(1){height:5px;animation-delay:0s;}
  .wave i:nth-child(2){height:12px;animation-delay:.12s;}
  .wave i:nth-child(3){height:8px;animation-delay:.24s;}
  .wave i:nth-child(4){height:14px;animation-delay:.36s;}
  .wave i:nth-child(5){height:6px;animation-delay:.48s;}
  @keyframes wv{0%,100%{transform:scaleY(.4);}50%{transform:scaleY(1);}}
  .mic-zone{display:flex;align-items:center;gap:18px;margin-bottom:24px;}
  .mic-btn{width:64px;height:64px;border-radius:50%;background:var(--accent);display:flex;align-items:center;justify-content:center;color:#fff;font-size:24px;box-shadow:0 0 0 8px var(--accent-soft);flex:none;}
  .mic-timer{font-size:13px;font-weight:700;color:var(--ink);font-variant-numeric:tabular-nums;}
  .mic-hint{font-size:11.5px;color:var(--ink-faint);}
  .qlist{display:flex;flex-direction:column;gap:8px;}
  .qlist .qi{display:flex;align-items:center;gap:9px;font-size:12px;color:var(--ink-faint);padding:6px 8px;border-radius:9px;}
  .qlist .qi.done{color:var(--success);}
  .qlist .qi.now{background:var(--brand-soft);color:var(--brand-dark);font-weight:700;}
  .qlist .dot{width:8px;height:8px;border-radius:50%;background:#D9D6EE;flex:none;}
  .qlist .qi.done .dot{background:var(--success);}
  .qlist .qi.now .dot{background:var(--brand);}

  .answer-box{background:#FBFAFF;border:1px solid var(--line);border-radius:var(--radius-md);padding:16px 18px;font-size:13.5px;color:var(--ink-soft);line-height:1.6;margin-bottom:20px;max-width:480px;}
  .tag-stt{font-size:10px;font-weight:700;color:var(--success);background:var(--success-soft);border-radius:100px;padding:3px 8px;margin-bottom:8px;display:inline-block;}

  /* Report */
  .report-grid{display:grid;grid-template-columns:220px 1fr;gap:32px;margin-bottom:20px;}
  .score-hero{text-align:center;background:#FBFAFF;border:1px solid var(--line);border-radius:var(--radius-md);padding:30px 10px;}
  .score-num{font-size:48px;font-weight:800;color:var(--brand);letter-spacing:-0.02em;}
  .score-label{font-size:12px;color:var(--ink-faint);font-weight:600;}
  .bar-row{margin-bottom:14px;}
  .bar-row .bhead{display:flex;justify-content:space-between;font-size:12.5px;font-weight:600;margin-bottom:6px;color:var(--ink-soft);}
  .bar-track{height:7px;border-radius:100px;background:var(--surface-2);}
  .bar-fill{height:100%;border-radius:100px;background:var(--success);}

  /* History table */
  table.hist{width:100%;border-collapse:collapse;}
  table.hist th{text-align:left;font-size:11.5px;color:var(--ink-faint);font-weight:700;padding:0 10px 12px;border-bottom:1px solid var(--line);}
  table.hist td{padding:14px 10px;border-bottom:1px solid var(--line);font-size:13px;}
  table.hist tr:last-child td{border-bottom:none;}
  .score-pill{font-size:12px;font-weight:800;padding:6px 10px;border-radius:100px;background:var(--success-soft);color:var(--success);display:inline-block;}
  .tbl-link{font-size:12.5px;font-weight:700;color:var(--brand);cursor:pointer;}

  .spacer{flex:1;}

  /* Caption */
  .caption{width:100%;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-md);padding:16px 22px;display:flex;gap:26px;}
  .caption-col{flex:1;}
  .caption-label{font-size:11.5px;font-weight:700;color:var(--ink-faint);margin-bottom:5px;}
  .caption-text{font-size:13.5px;color:var(--ink);line-height:1.5;}

  @media (max-width:900px){
    .stage{grid-template-columns:1fr;}
    .nav{position:static;flex-direction:row;overflow-x:auto;gap:8px;padding:8px;}
    .nav-item{flex:none;width:auto;}
    .auth-wrap,.dash-grid,.upload-grid,.iv-grid,.report-grid{grid-template-columns:1fr;}
    .auth-brand{display:none;}
    .form-grid{grid-template-columns:1fr;}
  }
</style>
</head>
<body>

  <div class="topbar">
    <div class="logo">MY<span>PASS</span></div>
    <div class="badge-tag">AI 음성 모의면접 웹사이트</div>
  </div>

  <div class="hero">
    <h1>공부한 지식을,<br>면접에서 설명할 수 있도록.</h1>
    <p>브라우저에서 이용하는 웹 서비스예요. 왼쪽 목록을 눌러 로그인부터 결과 리포트까지 화면 흐름을 순서대로 살펴보세요.</p>
  </div>

  <div class="stage">
    <div class="nav" id="nav"></div>

    <div class="browser-wrap">
      <div class="browser-frame">
        <div class="browser-bar">
          <div class="browser-dots"><span></span><span></span><span></span></div>
          <div class="browser-url" id="url">mypass.ai/login</div>
        </div>
        <div class="browser-body" id="screen"></div>
      </div>

      <div class="caption">
        <div class="caption-col">
          <div class="caption-label">사용자 행동</div>
          <div class="caption-text" id="cap-user"></div>
        </div>
        <div class="caption-col">
          <div class="caption-label">시스템 동작</div>
          <div class="caption-text" id="cap-system"></div>
        </div>
      </div>
    </div>
  </div>

<script>
function appnav(active, showMenu=true){
  return `
    <div class="appnav">
      <div class="appnav-brand">MY<span>PASS</span></div>
      ${showMenu ? `
      <div class="appnav-menu">
        <a class="${active==='home'?'active':''}">홈</a>
        <a class="${active==='project'?'active':''}">프로젝트</a>
        <a class="${active==='interview'?'active':''}">면접</a>
        <a class="${active==='history'?'active':''}">면접 기록</a>
      </div>
      <div class="appnav-right"><div class="avatar">🙂</div></div>
      ` : `<div class="exit-link">면접 종료</div>`}
    </div>
  `;
}

const screens = [
  {
    num:'01', key:'login', label:'로그인', url:'mypass.ai/login',
    userAction:'이메일과 비밀번호를 입력하고 로그인해요.',
    systemAction:'입력한 계정 정보로 사용자 인증을 처리해요.',
    render:()=>`
      <div class="auth-wrap">
        <div class="auth-brand">
          <div class="tag">공부한 지식을,<br>면접에서 설명할 수 있도록.</div>
          <div class="sub">프로젝트 자료를 분석해 나만의 면접 질문을 만들고, AI 면접관과 음성으로 연습해요.</div>
        </div>
        <div class="auth-form">
          <div class="scr-title">다시 오셨네요</div>
          <div class="scr-sub">계정으로 로그인하고 면접 연습을 시작하세요</div>
          <div class="field"><label>이메일</label><input placeholder="you@email.com"></div>
          <div class="field"><label>비밀번호</label><input type="password" placeholder="••••••••"></div>
          <div class="checkrow"><span>로그인 상태 유지</span><span>비밀번호 찾기</span></div>
          <button class="btn btn-primary btn-block">로그인</button>
          <div class="link-row">계정이 없으신가요? <b>회원가입</b></div>
        </div>
      </div>
    `
  },
  {
    num:'02', key:'mypage', label:'마이페이지', url:'mypass.ai/home',
    userAction:'프로젝트 목록과 최근 면접 결과를 확인해요.',
    systemAction:'사용자의 프로젝트와 면접 기록을 불러와요.',
    render:()=>`
      ${appnav('home')}
      <div class="page">
        <div class="dash-head">
          <div><div class="scr-title" style="margin-bottom:2px">안녕하세요, 지원 님</div><div class="scr-sub" style="margin:0">오늘도 한 문제만 더 말해볼까요?</div></div>
        </div>
        <div class="dash-grid">
          <div>
            <div class="section-title">내 프로젝트</div>
            <div class="proj-grid">
              <div class="card"><div class="card-title">추천 순위 매칭 서비스</div><div class="card-sub">담당: 백엔드</div><span class="chip">Spring Boot</span><span class="chip">React</span></div>
              <div class="card"><div class="card-title">실시간 채팅 서버</div><div class="card-sub">담당: 서버 설계</div><span class="chip">WebSocket</span><span class="chip">Redis</span></div>
            </div>
          </div>
          <div>
            <div class="section-title">면접 시작</div>
            <div class="cta-card">
              <div class="t1">🎙 새 면접 시작하기</div>
              <div class="t2">프로젝트를 선택하고 바로 연습해요</div>
              <button class="btn btn-block">시작하기</button>
            </div>
            <div class="card"><div class="card-title">최근 면접 · 09.12</div><div class="card-sub">종합 점수 82점 · 8문항</div></div>
          </div>
        </div>
      </div>
    `
  },
  {
    num:'03', key:'project', label:'프로젝트 등록', url:'mypass.ai/projects/new',
    userAction:'프로젝트명, 기술 스택, 담당 역할을 입력해요.',
    systemAction:'입력한 프로젝트 정보를 저장해요.',
    render:()=>`
      ${appnav('project')}
      <div class="page">
        <div class="scr-title">프로젝트 등록</div>
        <div class="scr-sub">면접 질문의 기반이 되는 정보예요</div>
        <div class="form-grid">
          <div class="field full"><label>프로젝트명</label><input placeholder="예: 추천 순위 매칭 서비스"></div>
          <div class="field full"><label>한 줄 소개</label><input placeholder="어떤 문제를 해결했나요?"></div>
          <div class="field"><label>기술 스택</label><input placeholder="React, Spring Boot"></div>
          <div class="field"><label>담당 역할</label><input placeholder="백엔드 API 설계"></div>
        </div>
        <button class="btn btn-primary" style="margin-top:6px">저장하고 계속하기</button>
      </div>
    `
  },
  {
    num:'04', key:'upload', label:'PDF 업로드', url:'mypass.ai/projects/1/upload',
    userAction:'이력서 또는 프로젝트 PDF를 올려요.',
    systemAction:'파일을 검증하고 텍스트를 추출·분석해요.',
    render:()=>`
      ${appnav('project')}
      <div class="page">
        <div class="scr-title">자료 업로드</div>
        <div class="scr-sub">이력서나 프로젝트 문서를 PDF로 올려주세요</div>
